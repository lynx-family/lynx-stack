{
  "typescript": {
    "lineWidth": 80,
    "semiColons": "prefer",
    "quoteStyle": "alwaysSingle",

    "module.sortImportDeclarations": "maintain",
    "module.sortExportDeclarations": "maintain",
    "exportDeclaration.sortNamedExports": "maintain",
    "importDeclaration.sortNamedImports": "maintain",
  },
  "json": {
    "jsonTrailingCommaFiles": [
      ".vscode/extensions.json",
      ".vscode/settings.json",
      "tsconfig.json",
      "tsconfig.build.json",
      "tsconfig.node.json",
      "api-extractor.json",
    ],
  },
  "markdown": {
  },
  "toml": {
  },
  "malva": {
  },
  "markup": {
  },
  "yaml": {
  },
  "excludes": [
    // Dependencies
    "**/node_modules",
    "**/*-lock.json",
    "pnpm-lock.yaml",

    // Outputs
    "**/lib/**",
    "**/dist/**",
    "**/etc/*.md",
    "packages/lynx/headless-rust-test-runner/fixtures/**",
    "website/docs/en/api/**",
    "website/docs/zh/api/**",
    "website/docs/en/changelog/**",
    "website/docs/zh/changelog/**",
    "packages/web-platform/web-explorer/preinstalled/**",

    // Generated by Next.js ("should not be edited"); its quote style is
    // regenerated on every build and would otherwise churn against dprint.
    "**/next-env.d.ts",

    // The tsconfig.json contains comments that align with indents.
    "/tsconfig.json",

    // Tests depend on format
    "packages/tools/css-serializer/test/__preparation__/**",
    "packages/webpack/css-extract-webpack-plugin/test/js/**",
    "packages/webpack/css-extract-webpack-plugin/test/rspack-js/**",
    "packages/**/test/**/diagnostic/**",
    "**/expected/**",
    "**/rspack-expected/**",
    "packages/**/test/**/hotCases/**",
    "packages/web-platform/**/binary/**/*.d.ts",
  ],
  "plugins": [
    "npm:@dprint/dockerfile@0.3.2",
    "npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67",
    "npm:@dprint/typescript@0.95.0",
    "npm:@dprint/json@0.20.0",
    "npm:@dprint/markdown@0.18.0",
    "npm:@dprint/toml@0.7.0",
    "npm:dprint-plugin-malva@0.12.0",
    "npm:dprint-plugin-markup@0.20.0",
    "npm:dprint-plugin-yaml@0.5.0",
  ],
}
