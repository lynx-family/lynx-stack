{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "dependsOn": [
        "//#build",
        "^build"
      ],
      "inputs": [
        "scripts/**",
        "../packages/**/src/**",
        "../packages/**/types/**"
      ],
      "outputs": [
        "api-data/**",
        "content/**"
      ]
    },
    "build": {
      "env": [
        "NODE_ENV"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../packages/**/CHANGELOG.md",
        "../packages/genui/**/*.md"
      ],
      "outputs": [
        "doc_build/**"
      ]
    },
    "dev": {
      "env": [
        "NODE_ENV"
      ],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": [
        "//#build",
        "^build"
      ],
      "cache": false
    }
  }
}
