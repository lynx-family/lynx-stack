{
  "id": "runtime-wrapper-webpack-plugin",
  "package": "@lynx-js/runtime-wrapper-webpack-plugin",
  "version": "0.2.4",
  "description": "Use runtime wrapper which allow JavaScript to be load by Lynx.",
  "group": "internals",
  "srcUrl": "https://github.com/lynx-family/lynx-stack/tree/main/packages/webpack/runtime-wrapper-webpack-plugin",
  "exports": [
    {
      "name": "RuntimeWrapperWebpackPlugin",
      "kind": "class",
      "type": "unknown",
      "summary": "RuntimeWrapperWebpackPlugin adds runtime wrappers to JavaScript and allow to be loaded by Lynx.",
      "members": [
        {
          "name": "constructor",
          "type": "constructor(options: Partial<RuntimeWrapperWebpackPluginOptions>): RuntimeWrapperWebpackPlugin",
          "kind": "constructor",
          "params": [
            {
              "name": "options",
              "type": "Partial<RuntimeWrapperWebpackPluginOptions>",
              "refs": [
                "RuntimeWrapperWebpackPluginOptions"
              ]
            }
          ],
          "returns": {
            "type": "RuntimeWrapperWebpackPlugin",
            "refs": [
              "RuntimeWrapperWebpackPlugin"
            ]
          }
        },
        {
          "name": "defaultOptions",
          "type": "Readonly<Required<RuntimeWrapperWebpackPluginOptions>>",
          "refs": [
            "RuntimeWrapperWebpackPluginOptions"
          ],
          "summary": "`defaultOptions` is the default options that the [`RuntimeWrapperWebpackPlugin`](api:RuntimeWrapperWebpackPlugin) uses.",
          "kind": "property"
        },
        {
          "name": "apply",
          "type": "apply(compiler: Compiler): void",
          "kind": "method",
          "params": [
            {
              "name": "compiler",
              "type": "Compiler",
              "description": "the webpack compiler"
            }
          ],
          "returns": {
            "type": "void"
          },
          "summary": "The entry point of a webpack plugin."
        }
      ]
    },
    {
      "name": "RuntimeWrapperWebpackPluginOptions",
      "kind": "interface",
      "type": "unknown",
      "summary": "The options for RuntimeWrapperWebpackPluginOptions",
      "members": [
        {
          "name": "bannerType",
          "type": "(filename: string) => \"script\" | \"bundle\"",
          "summary": "There are two types of banners: script(for app-service) and bundle(for js-render). You can decide to use which banner by the filename.",
          "default": "`() => 'script'`",
          "kind": "property"
        },
        {
          "name": "experimental_isLazyBundle",
          "optional": true,
          "type": "boolean",
          "summary": "[`PluginReactLynxOptions.experimental_isLazyBundle`](api:@lynx-js/react-rsbuild-plugin#PluginReactLynxOptions.experimental_isLazyBundle)",
          "kind": "property"
        },
        {
          "name": "injectVars",
          "optional": true,
          "type": "((vars: string[]) => string[]) | string[]",
          "summary": "A function that receives the default variable list and returns the list to inject.",
          "kind": "property"
        },
        {
          "name": "targetSdkVersion",
          "type": "string",
          "summary": "[`PluginReactLynxOptions.targetSdkVersion`](api:@lynx-js/react-rsbuild-plugin#PluginReactLynxOptions.targetSdkVersion)",
          "kind": "property"
        },
        {
          "name": "test",
          "type": "Rules | undefined",
          "summary": "Wrap the emitted JS assets whose filenames match this condition.\nAssets marked as main thread are never wrapped.",
          "default": "`/\\.js$/`",
          "kind": "property"
        }
      ]
    }
  ]
}
