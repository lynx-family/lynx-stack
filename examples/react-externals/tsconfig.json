  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "noEmit": true,

    "allowJs": true,
    "checkJs": true,
    "isolatedDeclarations": false,
  },
  "include": [
    "src",
