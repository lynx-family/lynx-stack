  "references": [
    { "path": "../../packages/react/tsconfig.json" },
    { "path": "../../packages/rspeedy/plugin-lynx/tsconfig.build.json" },
    { "path": "../../packages/rspeedy/plugin-qrcode/tsconfig.build.json" },
    { "path": "../../packages/rspeedy/plugin-react/tsconfig.build.json" },
  ],
}
