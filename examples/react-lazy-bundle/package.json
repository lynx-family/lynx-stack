{
  "name": "@lynx-js/example-react-lazy-bundle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:querycomponent && pnpm run build:fetchbundle",
    "build:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 rsbuild build",
    "build:querycomponent": "rsbuild build",
    "dev": "rsbuild dev",
    "dev:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 rsbuild dev",
    "preview": "rsbuild preview",
    "preview:fetchbundle": "cross-env LAZY_BUNDLE_FETCHBUNDLE=1 rsbuild preview"
  },
  "dependencies": {
    "@lynx-js/react": "workspace:*"
  },
  "devDependencies": {
    "@lynx-js/preact-devtools": "catalog:lynxjs",
    "@lynx-js/qrcode-rsbuild-plugin": "workspace:*",
    "@lynx-js/react-rsbuild-plugin": "workspace:*",
    "@lynx-js/rsbuild-plugin": "workspace:*",
    "@lynx-js/types": "4.1.0",
    "@rsbuild/core": "catalog:rsbuild",
    "@types/react": "^19.2.18",
    "cross-env": "^10.1.0"
  }
}
