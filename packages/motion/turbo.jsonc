{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
      ],
      "inputs": [
        "$TURBO_ROOT$/tsconfig.json",
        "tsconfig.build.json",
        "package.json",
        "src/**",
        "build/**",
        "rslib.config.ts",
      ],
      "outputs": [
        "dist/**",
      ],
    },
    "test": {
      "dependsOn": [
        "build",
      ],
    },
  },
}
