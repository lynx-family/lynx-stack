{
  "name": "@lynx-js/react-signals",
  "version": "0.0.3",
  "description": "Thread-aware Preact Signals integration for ReactLynx.",
  "keywords": [
    "lynx",
    "preact",
    "react",
    "signals"
  ],
  "repository": {
    "type": "git",
