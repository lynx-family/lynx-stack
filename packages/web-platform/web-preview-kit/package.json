{
  "name": "@lynx-js/web-preview-kit",
  "version": "0.0.0",
  "private": true,
  "description": "A page that builds and previews ReactLynx cards in a browser, driven over postMessage.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/web-platform/web-preview-kit"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rsbuild build",
    "coverage": "nyc report --cwd=$(realpath ../)",
    "coverage:ci": "nyc report --cwd=$(realpath ../) --reporter=lcov",
    "serve": "node ./scripts/serve.mjs",
    "test:e2e": "playwright test",
    "test:type": "tsc6 --noEmit"
  },
  "devDependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/web-bundle-kit": "workspace:*",
    "@lynx-js/web-core": "workspace:*",
    "@lynx-js/web-elements": "workspace:*",
    "@lynx-js/web-platform-rsbuild-plugin": "workspace:*",
    "@playwright/test": "catalog:",
    "@rsbuild/core": "catalog:rsbuild",
    "nyc": "^18.0.0",
    "tslib": "^2.8.1",
    "v8-to-istanbul": "^9.3.0"
  }
}
