{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build:wasm": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "scripts/**",
        "Cargo.toml",
        "package.json",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock"
      ],
      "outputs": ["binary/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:wasm"],
      "inputs": ["src/**", "ts/**", "css/**", "*.ts"],
      "outputs": ["dist/**"]
    }
  }
}
