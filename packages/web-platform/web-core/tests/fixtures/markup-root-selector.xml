<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE lynx>
<lynx version="5.4.2">
<style><![CDATA[
  /*
    This card pins down selector rewriting and at-rule dropping.

    A markup card's CSS is tokenized on the way in, so `:root` is rewritten to
    the card's own root element. Both declarations below therefore reach the
    card even though it renders inside a shadow root, where a literal `:root`
    would match nothing:

      - `background-color` applies to the card's root element;
      - `--root-accent` is in scope for the card, so the `var()` in `.probe`
        resolves against it.

    `.control` is the same construct declared on the root element's own class.
    Both resolving is what proves the rewrite happened rather than the card
    having simply avoided `:root`.

    `.dropped` sits inside an `@media` block. Conditional group rules have no
    rule kind in the binary style format, so they are not Lynx features on any
    platform, and are discarded rather than handed to the browser - which would
    give a web-only markup card a capability native does not have. The query is
    written to always match, so the declaration would be in effect had the block
    survived; `.control` carries the same kind of declaration outside any block
    and is the positive control for it.
  */
  :root {
    --root-accent: #2f6d54;
    background-color: #2f6d54;
  }

  .page {
    --page-accent: #4c8665;
  }

  .probe {
    width: 100%;
    height: 20px;
    background-color: var(--root-accent);
  }

  .control {
    width: 100%;
    height: 20px;
    background-color: var(--page-accent);
  }

  @media (min-width: 1px) {
    .dropped {
      width: 100%;
      height: 20px;
      background-color: #123f35;
    }
  }
]]></style>

<script main-thread="true"><![CDATA[
  const page = __CreatePage('0', 0);
  const pageId = __GetElementUniqueID(page);
  const engine = lynx.getEngine();
  let rendered = false;

  __SetClasses(page, 'page');

  Object.assign(globalThis, {
    processData(data) {
      return data;
    },
  });

  function onRenderPage() {
    if (rendered) {
      return;
    }
    rendered = true;
    ['probe', 'control', 'dropped'].forEach((className) => {
      const node = __CreateView(pageId);
      __SetClasses(node, className);
      __AppendElement(page, node);
    });
  }

  engine.addEventListener('__RenderPage', onRenderPage);
]]></script>

<script background="true"><![CDATA[
  lynx.getCoreContext();
]]></script>
</lynx>
