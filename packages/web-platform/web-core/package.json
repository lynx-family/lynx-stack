{
  "name": "@lynx-js/web-core",
  "version": "0.25.0",
  "description": "The Web Platform of Lynx / Lynx for Web",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/web-platform/web-core"
  },
  "files": [
    "dist",
    "binary",
    "css",
    "!dist/**/*.map",
    "*.d.ts",
    "*.js",
    "LICENSE.txt",
    "Notice.txt",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/client/index.js",
  "exports": {
    "./encode": {
      "types": "./dist/encode/index.d.ts",
      "import": "./dist/encode_prod/index.js",
      "default": "./dist/encode_prod/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server_prod/index.js",
      "default": "./dist/server_prod/index.js"
    },
    "./client.prod.js": {
      "default": "./dist/client_prod/static/js/client.js"
    },
    "./client.prod.css": {
      "default": "./dist/client_prod/static/css/client.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rsbuild build && rslib build",
    "build:wasm": "node ./scripts/build.js",
    "test": "rstest"
  },
  "dependencies": {
    "@lynx-js/css-serializer": "workspace:*",
    "@lynx-js/web-elements": "workspace:*",
    "@lynx-js/web-worker-rpc": "workspace:*",
    "wasm-feature-detect": "^1.8.0"
  },
  "devDependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "@rsbuild/core": "catalog:rsbuild",
    "@rsbuild/plugin-eslint": "1.3.0",
    "@rsbuild/plugin-source-build": "1.0.6",
    "@rslib/core": "catalog:rslib",
    "@rstest/core": "catalog:rstest",
    "@types/node": "^24.13.3",
    "binaryen": "^131.0.0",
    "eslint-plugin-compat": "^6.2.1",
    "fb-dotslash": "^0.5.8",
    "jsdom": "^27.4.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@lynx-js/lynx-core": "0.1.4",
    "tslib": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "@lynx-js/lynx-core": {
      "optional": true
    },
    "tslib": {
      "optional": true
    }
  },
  "browserslist": {
    "production": [
      "Chrome >= 92",
      "Safari >= 16.4"
    ],
    "development": [
      "last 1 chrome version"
    ]
  }
}
