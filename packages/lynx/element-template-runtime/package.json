{
  "name": "@lynx-js/element-template-runtime",
  "version": "0.0.0",
  "description": "Framework-neutral Element Template runtime primitives for Lynx.",
  "keywords": [
    "lynx",
    "element template",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/lynx/element-template-runtime"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "test": "vitest run",
    "test:type": "tsc6 --project tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@lynx-js/lynx-runtime": "workspace:*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  }
}
