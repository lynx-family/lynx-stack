{
  "name": "@lynx-js/genui-openui",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/genui/openui"
  },
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    "./styles/theme.css": "./styles/theme.css",
    "./styles/material-icons.css": "./styles/material-icons.css",
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./explicit": {
      "types": "./dist/core/explicit.d.ts",
      "default": "./dist/core/explicit.js"
    },
    "./data-tools": {
      "types": "./dist/data-tools/index.d.ts",
      "default": "./dist/data-tools/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./catalog/agent": {
      "types": "./dist/catalog/agent.d.ts",
      "default": "./dist/catalog/agent.js"
    },
    "./catalog/agent/*": {
      "types": "./dist/catalog/*/definition.d.ts",
      "default": "./dist/catalog/*/definition.js"
    },
    "./catalog/*": {
      "types": "./dist/catalog/*/index.d.ts",
      "default": "./dist/catalog/*/index.jsx"
    },
    "./openui-prompt": {
      "types": "./dist/openui-prompt/index.d.ts",
      "default": "./dist/openui-prompt/index.js"
    },
    "./chat": {
      "types": "./dist/chat/index.d.ts",
      "default": "./dist/chat/index.js"
    },
    "./chat/agent": {
      "types": "./dist/chat/agent.d.ts",
      "default": "./dist/chat/agent.js"
    },
    "./chat/agent/*": {
      "types": "./dist/chat/*/definition.d.ts",
      "default": "./dist/chat/*/definition.js"
    },
    "./chat/*": {
      "types": "./dist/chat/*/index.d.ts",
      "default": "./dist/chat/*/index.jsx"
    }
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "styles",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc6 -p tsconfig.build.json && cp src/core/renderer.css dist/core/renderer.css",
    "build:api": "tsc6 -p tsconfig.build.json",
    "test": "rstest"
  },
  "dependencies": {
    "@openuidev/lang-core": "^0.3.0",
    "marked": "^14.0.0",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@lynx-js/lynx-ui": "^3.135.4",
    "@lynx-js/react": "workspace:*",
    "@lynx-js/react-rsbuild-plugin": "workspace:*",
    "@lynx-js/types": "4.1.0",
    "@rstest/core": "catalog:rstest"
  },
  "peerDependencies": {
    "@lynx-js/lynx-ui": ">=3.133.0",
    "@lynx-js/react": ">=0.121.0"
  },
  "peerDependenciesMeta": {
    "@lynx-js/lynx-ui": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
