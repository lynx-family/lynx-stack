{
  "name": "@lynx-js/genui-server-bundle-rsbuild-plugin",
  "version": "0.0.0",
  "private": true,
  "description": "Internal GenUI Rsbuild plugin that creates server bundles for Lynx UI Judge.",
  "keywords": [
    "rsbuild",
    "Lynx",
    "server-bundle",
    "zip"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/genui/server-bundle-rsbuild-plugin"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "api-extractor": "api-extractor run --verbose",
    "build": "rslib build",
    "test": "pnpm -w run test --project genui/server-bundle"
  },
  "dependencies": {
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@lynx-js/react": "workspace:*",
    "@lynx-js/react-rsbuild-plugin": "workspace:*",
    "@lynx-js/rspeedy": "workspace:*",
    "@microsoft/api-extractor": "catalog:",
    "@rsbuild/core": "catalog:rsbuild"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
