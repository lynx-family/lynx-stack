{
  "name": "a2ui-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc6 --noEmit && rslib",
    "dev": "pnpm build && pnpm run --reporter=append-only \"/^dev:(build|server)$/\"",
    "dev:build": "rslib --watch",
    "dev:server": "node --watch dist/index.js",
    "lint": "eslint --ignore-pattern dist .",
    "start": "node dist/index.js",
    "test": "rstest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/typesafe-ai": "3.0.4",
    "@hono/node-server": "^2.1.0",
    "@lynx-js/genui-lynx-xml": "workspace:*",
    "@lynx-js/genui-mcp-apps": "workspace:*",
    "@lynx-js/genui-openui": "workspace:*",
    "@mastra/core": "1.68.0",
    "@openuidev/lang-core": "^0.3.0",
    "@volcengine/tos-sdk": "^2.9.1",
    "hono": "4.13.8",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@rslib/core": "catalog:rslib",
    "@rstest/core": "catalog:rstest",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "ajv": "^8.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
