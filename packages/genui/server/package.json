{
  "name": "a2ui-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc6 --noEmit && rslib build",
    "dev": "pnpm build && pnpm run --parallel \"/^dev:(build|server)$/\"",
    "dev:build": "rslib build --watch",
    "dev:server": "node --watch dist/index.js",
    "lint": "eslint --ignore-pattern dist .",
    "start": "node dist/index.js",
    "test": "rstest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.30",
    "@hono/node-server": "^2.1.0",
    "@lynx-js/genui-lynx-xml": "workspace:*",
    "@lynx-js/genui-mcp-apps": "workspace:*",
    "@lynx-js/genui-openui": "workspace:*",
    "@mastra/core": "1.63.2",
    "@openuidev/lang-core": "^0.2.11",
    "@volcengine/tos-sdk": "^2.9.1",
    "hono": "4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@rslib/core": "catalog:rslib",
    "@rstest/core": "catalog:rstest",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^22 || ^24"
  }
}
