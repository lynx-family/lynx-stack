{
  "name": "@lynx-js/genui",
  "version": "0.7.2",
  "description": "Generative UI for Lynx.",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/lynx-stack.git",
    "directory": "packages/genui"
  },
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./a2ui/styles/theme.css": "./a2ui/styles/theme.css",
    "./a2ui/styles/material-icons.css": "./a2ui/styles/material-icons.css",
    "./a2ui": {
      "types": "./a2ui/dist/index.d.ts",
      "default": "./a2ui/dist/index.js"
    },
    "./a2ui/0.9": {
      "types": "./a2ui/dist/index.d.ts",
      "default": "./a2ui/dist/index.js"
    },
    "./a2ui/store": {
      "types": "./a2ui/dist/store/index.d.ts",
      "default": "./a2ui/dist/store/index.js"
    },
    "./a2ui/snapshot": {
      "types": "./a2ui/dist/snapshot/index.d.ts",
      "default": "./a2ui/dist/snapshot/index.js"
    },
    "./a2ui/catalog": {
      "types": "./a2ui/dist/catalog/index.d.ts",
      "default": "./a2ui/dist/catalog/index.js"
    },
    "./a2ui/react": {
      "types": "./a2ui/dist/react/index.d.ts",
      "default": "./a2ui/dist/react/index.js"
    },
    "./a2ui/functions": {
      "types": "./a2ui/dist/functions/index.d.ts",
      "default": "./a2ui/dist/functions/index.js"
    },
    "./genui-cli": "./cli/bin/cli.js",
    "./a2ui-prompt": {
      "types": "./a2ui-prompt/dist/index.d.ts",
      "default": "./a2ui-prompt/dist/index.js"
    },
    "./a2ui-catalog-extractor": {
      "types": "./a2ui-catalog-extractor/dist/index.d.ts",
      "default": "./a2ui-catalog-extractor/dist/index.js"
    },
    "./a2ui-catalog-extractor/cli": {
      "types": "./a2ui-catalog-extractor/dist/cli.d.ts",
      "default": "./a2ui-catalog-extractor/dist/cli.js"
    },
    "./a2ui-catalog-extractor/skill": "./a2ui-catalog-extractor/skills/a2ui-catalog-extractor/SKILL.md",
    "./lynx-xml": {
      "types": "./lynx-xml/dist/index.d.ts",
      "default": "./lynx-xml/dist/index.js"
    },
    "./openui": {
      "types": "./openui/dist/core/index.d.ts",
      "default": "./openui/dist/core/index.js"
    },
    "./openui/explicit": {
      "types": "./openui/dist/core/explicit.d.ts",
      "default": "./openui/dist/core/explicit.js"
    },
    "./openui/data-tools": {
      "types": "./openui/dist/data-tools/index.d.ts",
      "default": "./openui/dist/data-tools/index.js"
    },
    "./openui/catalog": {
      "types": "./openui/dist/catalog/index.d.ts",
      "default": "./openui/dist/catalog/index.js"
    },
    "./openui/catalog/agent": {
      "types": "./openui/dist/catalog/agent.d.ts",
      "default": "./openui/dist/catalog/agent.js"
    },
    "./openui/catalog/agent/*": {
      "types": "./openui/dist/catalog/*/definition.d.ts",
      "default": "./openui/dist/catalog/*/definition.js"
    },
    "./openui/catalog/*": {
      "types": "./openui/dist/catalog/*/index.d.ts",
      "default": "./openui/dist/catalog/*/index.jsx"
    },
    "./openui/prompt": {
      "types": "./openui/dist/openui-prompt/index.d.ts",
      "default": "./openui/dist/openui-prompt/index.js"
    },
    "./openui/styles/theme.css": "./openui/styles/theme.css",
    "./mcp-apps": {
      "types": "./mcp-apps/dist/index.d.ts",
      "default": "./mcp-apps/dist/index.js"
    },
    "./mcp-apps/render": {
      "types": "./mcp-apps/dist/render/index.d.ts",
      "default": "./mcp-apps/dist/render/index.js"
    },
    "./mcp-apps/protocol": {
      "types": "./mcp-apps/dist/protocol.d.ts",
      "default": "./mcp-apps/dist/protocol.js"
    },
    "./mcp-apps/render/styles.css": "./mcp-apps/dist/render/styles.css",
    "./mcp-apps/styles.css": "./mcp-apps/dist/render/styles.css",
    "./reactlynx": {
      "types": "./reactlynx/dist/index.d.ts",
      "default": "./reactlynx/dist/index.js"
    },
    "./openui/chat": {
      "types": "./openui/dist/chat/index.d.ts",
      "default": "./openui/dist/chat/index.js"
    },
    "./openui/chat/agent": {
      "types": "./openui/dist/chat/agent.d.ts",
      "default": "./openui/dist/chat/agent.js"
    },
    "./openui/chat/agent/*": {
      "types": "./openui/dist/chat/*/definition.d.ts",
      "default": "./openui/dist/chat/*/definition.js"
    },
    "./openui/chat/*": {
      "types": "./openui/dist/chat/*/index.d.ts",
      "default": "./openui/dist/chat/*/index.jsx"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "a2ui-catalog-extractor": "./a2ui-catalog-extractor/bin/a2ui-catalog-extractor.js",
    "a2ui-cli": "./cli/bin/cli.js",
    "genui": "./cli/bin/cli.js",
    "genui-cli": "./cli/bin/cli.js"
  },
  "files": [
    "index.ts",
    "dist",
    "a2ui/dist",
    "a2ui/styles",
    "a2ui/*.md",
    "a2ui/docs/*.md",
    "a2ui/src/catalog/*.md",
    "cli/bin",
    "cli/dist",
    "cli/README.md",
    "cli/templates",
    "a2ui-prompt/dist",
    "a2ui-prompt/README.md",
    "a2ui-catalog-extractor/bin",
    "a2ui-catalog-extractor/dist",
    "a2ui-catalog-extractor/skills",
    "a2ui-catalog-extractor/README.md",
    "lynx-xml/dist",
    "lynx-xml/README*.md",
    "lynx-xml/docs/*.md",
    "openui/dist",
    "openui/styles",
    "openui/*.md",
    "openui/docs/*.md",
    "mcp-apps/dist",
    "reactlynx/dist",
    "reactlynx/README*.md",
    "reactlynx/docs/*.md"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc6 --project tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});\""
  },
  "dependencies": {
    "@a2ui/web_core": "0.10.6",
    "@lynx-js/config-rsbuild-plugin": "workspace:*",
    "@lynx-js/react-rsbuild-plugin": "workspace:^",
    "@lynx-js/react-signals": "workspace:*",
    "@lynx-js/rsbuild-plugin": "workspace:*",
    "@openuidev/lang-core": "^0.3.0",
    "@rsbuild/core": "catalog:rsbuild",
    "eslint-scope": "^8.4.0",
    "marked": "^14.1.4",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@lynx-js/genui-a2ui": "workspace:*",
    "@lynx-js/genui-a2ui-catalog-extractor": "workspace:*",
    "@lynx-js/genui-a2ui-prompt": "workspace:*",
    "@lynx-js/genui-cli": "workspace:*",
    "@lynx-js/genui-lynx-xml": "workspace:*",
    "@lynx-js/genui-mcp-apps": "workspace:*",
    "@lynx-js/genui-openui": "workspace:*",
    "@lynx-js/genui-reactlynx": "workspace:*",
    "@lynx-js/qrcode-rsbuild-plugin": "workspace:^",
    "@lynx-js/react": "workspace:^",
    "@lynx-js/rspeedy": "workspace:^"
  },
  "peerDependencies": {
    "@lynx-js/lynx-ui": ">=3.133.0",
    "@lynx-js/react": ">=0.121.0"
  },
  "peerDependenciesMeta": {
    "@lynx-js/lynx-ui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
