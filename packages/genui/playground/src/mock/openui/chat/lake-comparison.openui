root = Card([verdict, comparison, season])
verdict = TextContent("**喜欢完整湖面选A，喜欢层叠彩池地貌选B。** 两者主要差别在水景形态。")
comparison = Table([Col("维度", ["形态", "怎么选"]), Col("示例湖A", ["单个湖泊", "偏好完整湖面"]), Col("彩池B", ["层叠彩池群", "偏好彩池地貌；游记认为阳光下色彩更明显，这是作者观点"])] )
season = TextContent("指南介绍通常秋季可看彩林；灯光节资料只提供去年10月18日至11月5日的参考，**不能作为今年已确认日程**，订行程前需要核对当年公告。本次没有两地路线数据，不提供公里数或车程估计。")
