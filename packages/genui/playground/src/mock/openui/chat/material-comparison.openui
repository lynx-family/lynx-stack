root = Card([table, advice])
table = Table([Col("选项", ["P1", "P2"]), Col("已知面料", ["材料字段：氨纶18%；白色L的SKU描述写锦纶+氨纶，完整比例未取得", "材料字段：100%聚酯纤维；商家描述吸湿速干"]), Col("信息边界", ["不能推断其余82%的材质或推广到其他规格", "没有独立穿着测试，不能保证比P1更透气"])] )
advice = TextContent("更重视材料信息明确，可优先看P2；想选P1白色L，则先核对完整成分。现有材料只能比较已返回字段，不能据此判定哪件实际更凉或更舒适。")
