{
  "name": "Advanced Form Validator",
  "description": "Demonstrates complex validation logic and deeply nested formatting functions.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "gallery-advanced-validator",
        "catalogId": "https://unpkg.com/@lynx-js/genui/a2ui/dist/catalog.json",
        "sendDataModel": true
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "gallery-advanced-validator",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "main_column"
          },
          {
            "id": "main_column",
            "component": "Column",
            "children": [
              "welcome_text",
              "email_field",
              "phone_field",
              "zip_field",
              "terms_checkbox",
              "submit_btn"
            ],
            "align": "stretch"
          },
          {
            "id": "welcome_text",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "Hello! Today is ${formatDate(value: ${/now}, format: 'EEEE, MMMM d')}."
              }
            },
            "variant": "h3"
          },
          {
            "id": "email_field",
            "component": "TextField",
            "label": "Email Address",
            "value": {
              "@path": "/formData/email"
            },
            "@checks": [
              {
                "condition": {
                  "@call": "email",
                  "args": {
                    "value": {
                      "@path": "/formData/email"
                    }
                  }
                }
              }
            ]
          },
          {
            "id": "phone_field",
            "component": "TextField",
            "label": "Phone Number",
            "value": {
              "@path": "/formData/phone"
            },
            "@checks": [
              {
                "condition": {
                  "@call": "regex",
                  "args": {
                    "value": {
                      "@path": "/formData/phone"
                    },
                    "pattern": "^\\+?[0-9]{10,15}$"
                  }
                }
              }
            ]
          },
          {
            "id": "zip_field",
            "component": "TextField",
            "label": "Zip Code",
            "value": {
              "@path": "/formData/zip"
            },
            "@checks": [
              {
                "condition": {
                  "@call": "regex",
                  "args": {
                    "value": {
                      "@path": "/formData/zip"
                    },
                    "pattern": "^[0-9]{5}$"
                  }
                }
              }
            ]
          },
          {
            "id": "terms_checkbox",
            "component": "CheckBox",
            "label": "I agree to the terms and conditions",
            "value": {
              "@path": "/formData/agree"
            }
          },
          {
            "id": "submit_btn_text",
            "component": "Text",
            "text": "Submit Registration"
          },
          {
            "id": "submit_btn",
            "component": "Button",
            "child": "submit_btn_text",
            "@checks": [
              {
                "condition": {
                  "@path": "/formData/agree"
                }
              },
              {
                "condition": {
                  "@call": "or",
                  "args": {
                    "values": [
                      {
                        "@call": "required",
                        "args": {
                          "value": {
                            "@path": "/formData/email"
                          }
                        }
                      },
                      {
                        "@call": "required",
                        "args": {
                          "value": {
                            "@path": "/formData/phone"
                          }
                        }
                      }
                    ]
                  }
                }
              },
              {
                "condition": {
                  "@call": "required",
                  "args": {
                    "value": {
                      "@path": "/formData/zip"
                    }
                  }
                }
              }
            ],
            "action": {
              "event": {
                "name": "register",
                "context": {
                  "data": {
                    "@path": "/formData"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "gallery-advanced-validator",
        "value": {
          "now": "2025-12-15T12:00:00Z",
          "formData": {
            "email": "",
            "phone": "",
            "zip": "",
            "agree": false
          }
        }
      }
    }
  ]
}
